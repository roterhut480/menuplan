            ]
          }
        ],
        "schritte_fleisch": [
          {
            "titel": "Huehnchen schneiden",
            "text": "250 g Huehnchenbrust in Streifen von ca. 1 cm Breite schneiden. Auf ein Schneidebrett legen.",
            "timer_min": 0,
            "zutaten_schritt": [
              "Huehnchenbrust"
            ]
          },
          {
            "titel": "Huehnchen anbraten",
