              "Zwiebel"
            ]
          },
          {
            "titel": "Knoblauch hacken",
            "text": "10 g Knoblauch schaelen und fein hacken. Neben den Zwiebeln bereitstellen.",
            "timer_min": 0,
            "zutaten_schritt": [
              "Knoblauch"
            ]
          },
          {
            "titel": "Avocado vorbereiten",
            "text": "1 Avocado laengs durchschneiden, den Kern entfernen und das Fleisch mit einem Loeffel aus der Schale loesen. In Scheiben schneiden und auf einem Teller anrichten.",
            "timer_min": 0,
            "zutaten_schritt": [
              "Avocado"
            ]
          },
          {
            "titel": "Tortillas erwaermen",
